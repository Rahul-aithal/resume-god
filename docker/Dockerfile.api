# ---- stage 1: uv binary ----
FROM ghcr.io/astral-sh/uv:latest AS uvbin

# ---- stage 2: runtime ----
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    TYPST_VERSION=0.15.1

WORKDIR /app

COPY --from=uvbin /uv /bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Layer cache: deps first, then source.
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps/api/ ./

# Native Typst renderer (mirrors apps/api/scripts/install-typst.sh).
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
      x86_64) TARGET="x86_64-unknown-linux-musl" ;; \
      aarch64) TARGET="aarch64-unknown-linux-musl" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${TARGET}.tar.xz" -o /tmp/typst.tar.xz; \
    mkdir -p /tmp/typst-extract && tar -xJf /tmp/typst.tar.xz -C /tmp/typst-extract --strip-components=1; \
    mv /tmp/typst-extract/typst /usr/local/bin/typst; \
    chmod +x /usr/local/bin/typst; \
    rm -rf /tmp/typst.tar.xz /tmp/typst-extract; \
    typst --version

RUN uv sync --frozen --no-dev && uv run --no-sync python -m compileall -q resume_god

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /data /app/outputs \
    && chown -R appuser:appuser /app /data

# Secrets (LLM keys) and user data come from env/mounts, never the image.
VOLUME ["/data"]

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/')"

CMD ["resume-god", "web", "--host", "0.0.0.0", "--port", "8000"]
