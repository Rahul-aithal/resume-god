# Copy to apps/api/.env (local) or pass equivalent env to compose.
# LLM providers (auto = first key found wins, else offline deterministic)
GEMINI_API_KEY=
GLM_API_KEY=
RESUME_GOD_LLM_ORDER=gemini,glm
GEMINI_MODEL=gemini-3-flash-preview

# Phase B (multi-user): Postgres + auth. Tracker still uses SQLite today.
DATABASE_URL=postgresql://resume_god:resume-god-local@db:5432/resume_god
POSTGRES_DB=resume_god
POSTGRES_USER=resume_god
POSTGRES_PASSWORD=resume-god-local
# SESSION_SECRET=change-me-in-production

# OAuth login (B3): Google and GitHub. Unset providers 503 with setup help.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Local overrides
# TYPST_BIN=/path/to/typst
# RESUME_GOD_DB=/data/companies.db
