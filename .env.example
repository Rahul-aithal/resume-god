# resume-god — environment variables
# Copy to apps/server/.env (local) — validated at bootstrap by
# apps/server/src/config/environment.ts; malformed values abort startup.
# Everything is optional: the app boots fully offline without any keys.

# ---- Auth (Better Auth + Google OAuth) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin used to build OAuth redirect URIs. Defaults to the
# request origin; set it explicitly behind proxies/TLS.
# BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra CSRF-allowed origins (comma-separated), beyond the localhost defaults.
# AUTH_TRUSTED_ORIGINS=

# ---- LLM providers (optional; auto = first key found wins) ----
GEMINI_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible gateways:
# GLM_API_URL=https://api.z.ai/api/paas/v4/chat/completions
# OPENAI_API_URL=https://api.openai.com/v1
# Models (defaults shown):
# GEMINI_MODEL=gemini-3-flash-preview
# GLM_MODEL=glm-4.6
# OPENAI_MODEL=gpt-4.1
# Auto preference order:
# RESUME_GOD_LLM_ORDER=gemini,glm,openai

# ---- Database (single store: Postgres) ----
# DATABASE_URL=postgresql://resume_god:resume-god-local@localhost:5432/resume_god
# Test database (isolated from dev data):
# TEST_DATABASE_URL=postgresql://resume_god:resume-god-local@localhost:5433/resume_god_test

# ---- Server ----
# Typst binary for resume-PDF compilation (default: PATH "typst")
# TYPST_BIN=
# PORT=3000
# NODE_ENV=development
# Generated-file directory (default: repo-root outputs/)
# OUTPUTS_DIR=
