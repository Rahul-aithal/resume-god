# Copy to apps/api/.env (local) or pass equivalent env to compose.
# LLM providers (auto = first key found wins, else offline deterministic)
GEMINI_API_KEY=
GLM_API_KEY=
RESUME_GOD_LLM_ORDER=gemini,glm
GEMINI_MODEL=gemini-3-flash-preview

# Phase B (multi-user): Postgres + auth
DATABASE_URL=postgresql://resume_god:resume-god-local@db:5432/resume_god
POSTGRES_DB=resume_god
POSTGRES_USER=resume_god
POSTGRES_PASSWORD=resume-god-local
# Session signing key — generate once (`openssl rand -hex 32`); without it
# logins do not survive restarts.
# SESSION_SECRET=

# OAuth login: Google only (GitHub removed). Unconfigured → login button
# explains setup instead of crashing.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Register ONE redirect URI in Google Cloud Console → Credentials →
# OAuth client (Web application), matching how you browse the app:
#   prod docker (nginx)  http://localhost:8080/api/auth/callback/google
#   host dev (`bun run dev` + `resume-god web`)  http://localhost:8000/api/auth/callback/google
#   docker dev (vite :5173)                      http://localhost:5173/api/auth/callback/google

# Local overrides
# TYPST_BIN=/path/to/typst
# RESUME_GOD_DB=/data/companies.db
